# ZAYATHON Firebase Web Configuration
# Fill in the credentials from your Firebase Console -> Project Settings -> General -> Your apps -> Web app

FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=zayathon.firebaseapp.com
FIREBASE_PROJECT_ID=Zayathon
FIREBASE_STORAGE_BUCKET=zayathon.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
FIREBASE_APP_ID=your-firebase-app-id
FIREBASE_MEASUREMENT_ID=your-measurement-id
