rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper to check admin authorization via Firestore
    function isAdmin() {
      return request.auth != null &&
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    // Participant verification documents (College ID cards, Bonafide certificates, Project synopses)
    match /participants/{participantId}/{allPaths=**} {
      // Allow public upload during registration (max 10MB per file, images/PDFs only)
      allow write: if request.resource.size < 10 * 1024 * 1024
                   && (request.resource.contentType.matches('application/pdf') ||
                       request.resource.contentType.matches('image/.*'));
      // Only authorized admins can read / download submitted participant documents
      allow read: if isAdmin();
    }
  }
}
